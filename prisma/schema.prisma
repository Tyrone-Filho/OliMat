// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Perguntas {
  id        Int     @id @default(autoincrement())
  enunciado String  @db.MediumText
  q1        String  @db.MediumText
  r1        String  @db.MediumText
  q2        String? @db.MediumText
  r2        String? @db.MediumText
  q3        String? @db.MediumText
  r3        String? @db.MediumText

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model User {
  id        Int         @id @default(autoincrement())
  usuario   String      @unique @db.VarChar(255)
  senha     String      @db.VarChar(255)
  questoes  Perguntas[]
  permissao Boolean     @default(false)
}
